# Internal inbox where service quote requests should be delivered.
AXIVY_LEADS_TO=

# Verified sender address for Resend or SMTP; configure a real address before enabling email.
AXIVY_EMAIL_FROM=

# Preferred provider. When empty, the API route uses the SMTP settings below.
RESEND_API_KEY=

# SMTP fallback credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Optional GA4 measurement ID (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Sheets Webhook URL for Free Audit form submissions (Google Apps Script Web App URL)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxWn3F-4ITQWwrGWZiYDv7wHUIgte2qDYMbOTVvxc5rjGPWHUM4C0zc69PmhED2MsUN5Q/exec


