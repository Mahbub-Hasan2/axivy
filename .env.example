# Internal inbox where service quote requests should be delivered.
AXIVY_LEADS_TO=

# Verified sender address for Resend or SMTP; configure a real address before enabling email.
AXIVY_EMAIL_FROM=

# Preferred provider. When empty, the API route uses the SMTP settings below.
RESEND_API_KEY=

# SMTP fallback credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Optional GA4 measurement ID (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Apps Script Web App URL that receives lead/audit submissions and appends them to a
# Google Sheet. Set the real value only in .env.local (already gitignored) or in your hosting
# platform's environment variable settings — never commit a real URL here.
GOOGLE_SHEET_WEBHOOK_URL=

# Optional: a Calendly or Cal.com booking link. When set, the audit request success screen shows
# a "Schedule a Call" button linking here; when empty, only the WhatsApp fallback is shown.
NEXT_PUBLIC_SCHEDULING_LINK=
